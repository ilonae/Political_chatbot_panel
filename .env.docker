# ─────────────────────────────────────────────────────────────────
# Political AI Chatbot — Docker environment variables
# This file is used when running via docker-compose
# DO NOT commit this to version control if it contains real secrets
# ─────────────────────────────────────────────────────────────────

OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=dolphin-mistral

# ── Persona prompts ────────────────────────────────────────────────
# Full prompts are kept offline. Set these before running.
SYS_PROMPT_ENGLISH=<set before running>

SYS_PROMPT_GERMAN=<set before running>

# ── Application ────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost

# ── API server ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Timeouts & retries ─────────────────────────────────────────────
AI_TIMEOUT=120
AI_MAX_RETRIES=1
